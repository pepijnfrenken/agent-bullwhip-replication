.venv/
__pycache__/
*.pyc
results/
.pytest_cache/
*.egg-info/

# Regenerable model-training binaries — never tracked (kept on disk; see docs/ARTIFACTS.md)
# Checkpoint dirs pushed back from the cluster via push_results.sh are text readouts only;
# if a checkpoint dir is ever force-added again, these rules keep the heavy files out.
results/**/checkpoint*/
*.pt
optimizer*.pt
*.safetensors
adapter_model.safetensors
# WAVE8 CPU/GGUF step: models stay untracked (manifest.json + summaries are the evidence)
*.gguf
results/wave8_gguf/**/merged/

.env.local
# post drafts stay local — never in the repo
POSTS.md
POST_*.md

# local agent/mission runtime — never in the repo
.omp/
.mr-mission

# uv auto-generates an empty stub lockfile here (poetry-style pyproject has no [project]
# table, so uv cannot resolve a real lock; `uv run` works via requirements.txt). Keeping it
# untracked prevents a misleading 0-package lock from being committed.
uv.lock
